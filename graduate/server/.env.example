# 环境变量清单（复制为真实 env 使用，不入库）
# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=rental_env
MYSQL_USER=root
MYSQL_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT（生产必须 ≥256bit 随机串，可用 openssl rand -base64 48 生成）
JWT_SECRET=

# 微信小程序（mp.weixin.qq.com 开发设置页获取）
WX_APPID=
WX_SECRET=

# 阿里云 OSS（W4 文件上传阶段启用）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
