<view class="page">
  <view class="user-card card">
    <view class="avatar">{{userInfo.nickname ? userInfo.nickname[0] : '?'}}</view>
    <view class="user-info">
      <view class="card-title">{{userInfo.nickname || '未登录'}}</view>
      <view class="text-sub">手机号：{{userInfo.phone || '未绑定'}}</view>
    </view>
  </view>

  <!-- 模式切换胶囊：仅 BOTH 显示（SEEKING/LIVING 无可切目标） -->
  <view wx:if="{{mode === 'BOTH'}}" class="mode-switch" bindtap="onSwitchMode">
    <text>找房模式</text>
    <text>居住模式</text>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goAppointments" hover-class="menu-hover">
      <text>我的预约</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goApplications" hover-class="menu-hover">
      <text>我的申请</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goContracts" hover-class="menu-hover">
      <text>我的合同</text><text class="arrow">›</text>
    </view>
  </view>

  <view class="card">
    <button class="btn-primary logout" bindtap="onLogout">退出登录</button>
  </view>
</view>
