.page {
  padding-bottom: 140rpx;
}

.search-bar {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 18rpx 28rpx;
  display: flex;
  align-items: center;
  color: #909399;
  font-size: 26rpx;
}

.search-icon {
  margin-right: 12rpx;
}

.house-card {
  display: flex;
}

.house-cover {
  width: 160rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.house-info {
  flex: 1;
  min-width: 0;
}

.house-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.house-rent {
  color: var(--danger);
  font-weight: 700;
  font-size: 30rpx;
}

.living-head {
  padding: 60rpx 32rpx 10rpx;
}

.living-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}
