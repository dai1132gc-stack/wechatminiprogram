<view class="page">
  <view class="head">
    <view>
      <view class="head-title">{{houseTitle}}</view>
      <view class="text-sub">设备{{deviceStatus === 'ONLINE' ? '在线' : '离线'}} · 更新于 {{updatedAt}}</view>
    </view>
    <text class="tag {{deviceStatus === 'ONLINE' ? 'tag-success' : 'tag-gray'}}">
      {{deviceStatus === 'ONLINE' ? '在线' : '离线'}}
    </text>
  </view>

  <view class="metric-grid">
    <view wx:for="{{metrics}}" wx:key="key" class="card metric {{item.ok ? '' : 'metric-bad'}}">
      <view class="text-sub">{{item.label}}</view>
      <view class="metric-value">{{item.value}}</view>
    </view>
  </view>

  <view class="card entries">
    <view class="entry" bindtap="goHistory"><text>📈 历史趋势</text><text class="text-sub">›</text></view>
    <view class="entry" bindtap="goAlarm"><text>🔔 告警记录</text><text class="text-sub">›</text></view>
    <view class="entry" bindtap="goDevice"><text>📟 设备信息</text><text class="text-sub">›</text></view>
  </view>

  <view class="text-sub tip">W1 骨架：实时数据为占位读数，W5 接入真实上报链路</view>
</view>
