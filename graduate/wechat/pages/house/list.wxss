.page {
  padding-bottom: 40rpx;
}

.search-bar {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 28rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-btn {
  color: var(--brand);
  font-size: 26rpx;
  margin-left: 16rpx;
}

.house-card {
  display: flex;
}

.house-cover {
  width: 160rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.house-info {
  flex: 1;
  min-width: 0;
}

.house-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.house-rent {
  color: var(--danger);
  font-weight: 700;
  font-size: 30rpx;
}
