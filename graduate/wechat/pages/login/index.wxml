<view class="login-page">
  <view class="brand">
    <view class="brand-logo">🏠</view>
    <view class="brand-title">房屋租赁与环境监测</view>
    <view class="brand-slogan">找房 · 签约 · 住得安心</view>
  </view>

  <view class="login-body">
    <button
      class="btn-primary login-btn"
      loading="{{loading}}"
      bindtap="handleWxLogin"
    >
      微信一键登录
    </button>

    <view class="landlord-entry" bindtap="handleLandlordHint">我是房东 / 中介 →</view>

    <view class="agreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">✓</view>
      <text>已阅读并同意</text>
      <text class="link">《用户协议》</text>
      <text>和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>

  <view class="footer">W1 工程骨架 · Mock 模式</view>
</view>
